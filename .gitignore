# Environment secrets and local state
.env
vendor/
node_modules/
/writable/cache/*
!/writable/cache/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html
/writable/debugbar/*
!/writable/debugbar/index.html
php_errors.log
/tests/coverage*
/phpunit.xml
.DS_Store
Thumbs.db
.idea/
.vscode/
